# Copy to .env and fill in. Every setting is documented in backend/app/config.py.
# docker compose reads this file, and so does the API when run locally with uv (from backend/).
# After adding keys: cd backend && uv run python -m scripts.check_providers

# ---- Identity -------------------------------------------------------------------------
GW_ORG_NAME=YSH
GW_APP_NAME=Groundwork
GW_HOSTNAME=groundwork.local
# The address staff type into the browser. Sign-in links point here, so it must work
# from wherever staff read their email.
GW_PUBLIC_BASE_URL=https://groundwork.local

# ---- Access ---------------------------------------------------------------------------
# Only these email domains can sign in. Leave empty only for local development.
GW_ALLOWED_EMAIL_DOMAINS=yshproperty.com.au
GW_ADMIN_EMAILS=
GW_ANALYST_EMAILS=
GW_COOKIE_SECURE=true
GW_SESSION_DAYS=14
GW_MAX_UPLOAD_MB=100

# ---- Email (sign-in links) ------------------------------------------------------------
# Dev: run the Mailpit profile and set GW_SMTP_HOST=mailpit, GW_SMTP_PORT=1025, GW_SMTP_STARTTLS=false
GW_SMTP_HOST=
GW_SMTP_PORT=587
GW_SMTP_USER=
GW_SMTP_PASSWORD=
GW_SMTP_STARTTLS=true
GW_MAIL_FROM=groundwork@yshproperty.com.au
GW_DEV_LOG_MAGIC_LINKS=false

# ---- AI drafting and the session reviewer ---------------------------------------------
# none | ollama | anthropic | openai (OpenAI itself, or any OpenAI-compatible endpoint)
GW_AI_PROVIDER=openai
GW_OLLAMA_URL=http://inference-box:11434
GW_OLLAMA_MODEL=qwen3:14b
GW_ANTHROPIC_API_KEY=
GW_ANTHROPIC_MODEL=claude-sonnet-5
# Keep false. When a map or its files hold personal information, drafts run locally only.
GW_AI_ALLOW_CLOUD_FOR_PERSONAL_INFO=false

# OpenAI (GW_AI_PROVIDER=openai). Set the model to one your account can use.
GW_OPENAI_URL=https://api.openai.com/v1/chat/completions
GW_OPENAI_API_KEY=
GW_OPENAI_MODEL=
GW_OPENAI_IS_LOCAL=false

# ---- Live mapping (System One decision model) -----------------------------------------
# none | openrouter | jev
#   openrouter: TypeSafe Jev through OpenRouter's System One API (hosted). Needs the key below.
#   jev: TypeSafe's own endpoint, or a Laya or OpenJev server you run (set GW_DECISION_URL and,
#        for your own server, GW_DECISION_IS_LOCAL=true).
GW_DECISION_PROVIDER=openrouter
GW_OPENROUTER_API_KEY=
GW_DECISION_MODEL=jev-latest
GW_DECISION_URL=https://api.typesafe.ai/v1/systemone
GW_DECISION_API_KEY=
GW_DECISION_IS_LOCAL=false
GW_DECISION_MAX_OPTIONS=20
GW_LIVE_AUTO_THRESHOLD=0.75
GW_REVIEW_MINUTES=5

# ---- Transcription --------------------------------------------------------------------
# none | faster_whisper (build with WITH_WHISPER=true) | openai_compatible
GW_TRANSCRIPTION_PROVIDER=none
GW_WHISPER_MODEL=small.en
GW_TRANSCRIPTION_URL=
GW_TRANSCRIPTION_API_KEY=
WITH_WHISPER=false

# ---- File storage ---------------------------------------------------------------------
# local: files under ./data. s3: self-hosted Supabase Storage's S3 endpoint (or MinIO).
GW_STORAGE_BACKEND=local
# Supabase self-hosted: http://<supabase-host>:8000/storage/v1/s3, keys from the stack's
# S3_PROTOCOL_ACCESS_KEY_ID / S3_PROTOCOL_ACCESS_KEY_SECRET, region from its REGION setting.
GW_S3_ENDPOINT=
GW_S3_REGION=local
GW_S3_BUCKET=groundwork
GW_S3_ACCESS_KEY=
GW_S3_SECRET_KEY=
GW_S3_CA_FILE=

# ---- Ingestion pipeline (docs/INGESTION.md) --------------------------------------------
# Off until the services below are running. Then every clean upload is converted to Markdown,
# chunked, embedded and indexed, and its entities go into the knowledge graph.
GW_PIPELINE_ENABLED=false
# mineru-api on the inference box. Backend: pipeline (CPU or GPU), hybrid-engine or vlm-engine (GPU).
GW_MINERU_URL=http://inference:8000
GW_MINERU_BACKEND=pipeline
GW_MINERU_LANG=en
GW_MINERU_PAGE_BATCH=50
GW_GOTENBERG_URL=http://gotenberg:3000
# Embedding sidecar (rdb420/embedding-sidecar) and Qdrant. Chunks are at most GW_CHUNK_TOKENS long.
GW_EMBED_URL=http://inference:7860
GW_CHUNK_TOKENS=128
QDRANT_API_KEY=
GW_QDRANT_URL=https://qdrant:6333
GW_QDRANT_API_KEY=${QDRANT_API_KEY}
GW_QDRANT_CA_FILE=/data/qdrant-ca.pem
GW_QDRANT_COLLECTION=gw_chunks

# ---- Malware scanning -----------------------------------------------------------------
# The clamav service in docker-compose.yml. Leave empty to switch scanning off (not advised once
# staff outside the pilot can upload).
GW_CLAMAV_HOST=clamav
GW_CLAMAV_PORT=3310

# ---- Retention (agree the periods in docs/PRIVACY.md before rollout) -------------------
# Days after a contributor withdraws a file before it is deleted from disk. 0 keeps it.
GW_RETENTION_WITHDRAWN_DAYS=30
# Days after a recording ends before its audio is deleted. Transcripts stay with the map. 0 keeps it.
GW_RETENTION_AUDIO_DAYS=90
# true: the worker purges what is due once a day. false: an admin runs it from the Retention page.
GW_RETENTION_AUTO=true

# ---- Backups (deploy/backup.sh) -------------------------------------------------------
GW_BACKUP_KEEP_DAYS=30
# age public keys (age1...), comma separated. Every backup is encrypted to them. Keep the private
# key off this host. Required before backups are copied anywhere.
GW_BACKUP_AGE_RECIPIENTS=
# Where backup.sh copies the archives (an rsync destination off this host).
GW_BACKUP_COPY_TO=
