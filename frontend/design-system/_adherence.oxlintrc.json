{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/canvas/**",
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/navigation/**",
              "components/overlays/**",
              "components/session/**",
              "ui_kits/excel-to-webapp/**",
              "ui_kits/groundwork/**",
              "ui_kits/internal-app-starter/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Atkinson Hyperlegible|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: Atkinson Hyperlegible, Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShellNavGroup'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|items|key|ref|className|style|children)$/]",
        "message": "<AppShellNavGroup> doesn't accept that prop. Declared props: title, items."
      },
      {
        "selector": "JSXOpeningElement[name.name='BpmnData'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|key|ref|className|style|children)$/]",
        "message": "<BpmnData> doesn't accept that prop. Declared props: kind, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='BpmnData'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:object|store)$/]",
        "message": "<BpmnData> kind must be one of 'object' | 'store'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BpmnEvent'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|label|suggested|pending|selected|key|ref|className|style|children)$/]",
        "message": "<BpmnEvent> doesn't accept that prop. Declared props: kind, label, suggested, pending, selected."
      },
      {
        "selector": "JSXOpeningElement[name.name='BpmnEvent'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:start|intermediate|end)$/]",
        "message": "<BpmnEvent> kind must be one of 'start' | 'intermediate' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BpmnGateway'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|label|suggested|pending|selected|key|ref|className|style|children)$/]",
        "message": "<BpmnGateway> doesn't accept that prop. Declared props: type, label, suggested, pending, selected."
